# Clave compartida con el backend Django (cabecera X-API-Key). Debe ser la misma en ambos .env.
# Genera una larga y aleatoria; no se versiona la real.
ML_API_KEY=change-me

# Parametros del clustering (RF-17)
ML_K=3
ML_RANDOM_STATE=42
ML_MAX_ACTAS=20000

# Distancia (m) que se asume cuando un acta no tiene hidrante (coincide con D_MAX del scoring)
ML_DISTANCIA_SIN_HIDRANTE_M=500
